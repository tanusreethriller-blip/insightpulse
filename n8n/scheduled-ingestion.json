          }
        ]
      ]
    },
    "Submit analysis job": {
      "main": [
        [
          {
            "node": "Wait before polling",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait before polling": {
      "main": [
        [
          {
            "node": "Read analysis status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read analysis status": {
      "main": [
        [
          {
            "node": "Check failure and deadline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check failure and deadline": {
      "main": [
        [
          {
            "node": "Report ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report ready": {
      "main": [
        [
          {
            "node": "Notify owner - link only",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait before polling",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
