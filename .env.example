# Run python scripts/init_env.py to generate the ingestion token in .env.
INGEST_API_TOKEN=

# Open this EXACT origin in the browser (also used in n8n report links).
PUBLIC_URL=http://127.0.0.1:8000
TIMEZONE=Asia/Kolkata
PRODUCT_NAME=YourProduct
PRODUCT_DESCRIPTION="A software product used by customers."
DATA_DIR=./var

# local = deterministic keyword themes, no model API; llm = JSON model calls.
ANALYSIS_MODE=local
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# local = SQLite demonstration output; disabled = no publishing; mcp = n8n.
PUBLISH_MODE=local
N8N_MCP_URL=
N8N_MCP_TOKEN=
GOOGLE_DOC_ID=
REPORT_RECIPIENT=

MIN_REVIEWS=5
MAX_REVIEWS=5000
WORKER_ENABLED=true
